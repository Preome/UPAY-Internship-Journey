          }
        },
        {
          "name": "Reverse Transaction (Basic Auth)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "test123", "type": "string" },
                { "key": "username", "value": "testuser", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Incorrect amount\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/transactions/1/reverse/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "transactions", "1", "reverse", ""]
            }
          }
        }
      ]
    },
