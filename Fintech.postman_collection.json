          }
        },
        {
          "name": "Deposit (Basic Auth)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "test123", "type": "string" },
                { "key": "username", "value": "testuser", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"account\": 1,\n    \"transaction_type\": \"DEPOSIT\",\n    \"amount\": 1000.00,\n    \"description\": \"Basic Auth deposit\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/transactions/",
