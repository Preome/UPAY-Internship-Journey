            "auth": {
              "type": "basic",
              "basic": [
                { "key": "password", "value": "test123", "type": "string" },
                { "key": "username", "value": "testuser", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/accounts/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "accounts", ""]
